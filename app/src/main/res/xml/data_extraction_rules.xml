<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted secrets from cloud backup -->
        <exclude domain="sharedpref" path="secure_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
